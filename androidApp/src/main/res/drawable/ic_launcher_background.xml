<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background layer — brand gradient matching HeroGradient (Color.kt) and the
     Onboarding hero backdrop, so the launcher icon reads as the same brand as the app itself. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#7C6EFF"
                android:endColor="#B985FF" />
        </aapt:attr>
    </path>
</vector>
