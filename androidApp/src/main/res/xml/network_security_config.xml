<?xml version="1.0" encoding="utf-8"?>
<!--
   Applies to the app's own Android-side HTTP stack (Coil/Ktor thumbnail loading) only.
   yt-dlp's downloads run through Chaquopy's embedded Python/urllib, which uses its own TLS
   stack and isn't gated by this config — so this hardens thumbnail loading, not the download
   path itself.
-->
<network-security-config>
    <!-- No cleartext (http://) traffic anywhere by default; everything must be HTTPS. -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">facebook.com</domain>
        <domain includeSubdomains="true">instagram.com</domain>
        <domain includeSubdomains="true">fbcdn.net</domain>
        <domain includeSubdomains="true">cdninstagram.com</domain>
    </domain-config>
</network-security-config>
